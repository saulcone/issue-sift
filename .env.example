# Copy this file to .env and fill in the values. Never commit .env.

# GitHub personal access token (read-only, public repositories is enough).
# Without it the GitHub API allows only 60 requests per hour.
ISSUE_SIFT_GITHUB_TOKEN=

# Repository the dataset is built from, as owner/name.
ISSUE_SIFT_SOURCE_REPO=owner/name

# Where downloaded data is stored (git-ignored).
ISSUE_SIFT_DATA_DIR=data

# Local PostgreSQL (docker compose). Used from Phase 1 on.
ISSUE_SIFT_DATABASE_URL=postgresql://issue_sift:issue_sift@localhost:5432/issue_sift
